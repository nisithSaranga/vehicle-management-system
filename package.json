{
  "name": "vehicle-management-system",
  "private": true,
  "workspaces": [
    "dashboard",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev:dashboard": "npm --workspace dashboard run dev",
    "dev:mobile": "npm --workspace mobile start",
    "build:dashboard": "npm --workspace dashboard run build",
