{
  "expo": {
    "name": "Riyon Vehicle Management System",
    "slug": "riyon-international-fleet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.riyoninternational.vehiclemanagement",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/riyon-logo.png",
        "backgroundImage": "./assets/riyon-logo.png",
        "monochromeImage": "./assets/riyon-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/riyon-logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "ae13b31f-187d-41fa-9c48-7b4ddb77320e"
      }
    },
    "owner": "nisithsaranga"
  }
}
